# Database
DATABASE_URL=postgresql://investment_user:investment_pass@localhost:5432/investment_db

# CORS (comma-separated) — include your Vercel frontend domain when hosted
CORS_ORIGINS=http://localhost:3000,https://alphalens-research.vercel.app

# Market data provider: yfinance | alpaca
MARKET_DATA_PROVIDER=yfinance

# Alpaca (paper / free tier — used when MARKET_DATA_PROVIDER=alpaca)
# Sign up: https://app.alpaca.markets/signup
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# SEC EDGAR — required to query api per SEC fair-access policy
# Format: "Sample Company Name contact@example.com"
SEC_USER_AGENT=
EDGAR_RATE_LIMIT=10